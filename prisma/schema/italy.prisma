// -----------------------------------------------------------------------------
// 1. System Settings
// -----------------------------------------------------------------------------
model SystemConfig {
  id Int @id @default(autoincrement())

  seasonId Int
  season   Season @relation(fields: [seasonId], references: [id])

  currency          Currency?
  unitPrice         Decimal?
  smallBoxCapacity  Int       @default(50)
  mediumBoxCapacity Int       @default(30)
  largeBoxCapacity  Int       @default(24)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// 2. Fields Settings
// -----------------------------------------------------------------------------
model Field {
  id   Int    @id @default(autoincrement())
  name String

  fieldHarvests FieldHarvest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slug String @unique // URL-friendly slug

  @@unique([name])
}

// -----------------------------------------------------------------------------
// 3. Default Trader Categories (Global Defaults)
// -----------------------------------------------------------------------------
model DefaultTraderCategory {
  id              Int     @id @default(autoincrement())
  name            String  @unique
  notes           String?
  supportedGrades Grade[]
  gradeGroups     Json    @default("[]")
  orderIndex      Int     @default(0)

  shares DefaultTraderCategoryShare[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// 4. Default Trader Category Shares
// -----------------------------------------------------------------------------
model DefaultTraderCategoryShare {
  id Int @id @default(autoincrement())

  traderId Int
  trader   Trader @relation(fields: [traderId], references: [id], onDelete: Cascade)

  defaultTraderCategoryId Int
  defaultTraderCategory   DefaultTraderCategory @relation(fields: [defaultTraderCategoryId], references: [id], onDelete: Cascade)

  percent Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([traderId, defaultTraderCategoryId])
}

// -----------------------------------------------------------------------------
// 5. Traders
// -----------------------------------------------------------------------------
model Trader {
  id   Int    @id @default(autoincrement())
  name String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slug String @unique // URL-friendly slug

  // Relations
  defaultCategoryShares DefaultTraderCategoryShare[]
  traderCategoryShares  TraderCategoryShare[]
  classifications       Classification[]
  traderStocks          TraderStock[]
  customerAllocations   CustomerAllocation[]
  box                   Box[]
  shipmentItem          ShipmentItem[]
  seasonSettings        TraderSeasonSettings[]
}

// -----------------------------------------------------------------------------
// 6. Trader Season Settings (expense % + flat price per etrog, not category-scoped)
// -----------------------------------------------------------------------------
model TraderSeasonSettings {
  id Int @id @default(autoincrement())

  seasonId Int
  season   Season @relation(fields: [seasonId], references: [id])

  traderId Int
  trader   Trader @relation(fields: [traderId], references: [id])

  paymentPercent Decimal  @default(0) // % participation in shared expenses
  pricePerEtrog  Decimal  @default(0) // flat price per etrog, not category-dependent
  currency       Currency

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([traderId, seasonId])
}

// -----------------------------------------------------------------------------
// 7. Customer
// -----------------------------------------------------------------------------
model Customer {
  id           Int     @id @default(autoincrement())
  customerName String  @unique
  email        String? @unique
  phone        String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slug String @unique // URL-friendly slug

  // Relations
  prices          CustomerCategories[]
  allocations     CustomerAllocation[]
  classifications Classification[]
  box             Box[]
  shipmentItem    ShipmentItem[]

  @@index([customerName])
}

// -----------------------------------------------------------------------------
// 8. Traders categories
// -----------------------------------------------------------------------------
model TradersCategories {
  id              Int     @id @default(autoincrement())
  name            String // Category name (e.g., "Yanover")
  notes           String?
  seasonId        Int
  season          Season  @relation(fields: [seasonId], references: [id])
  supportedGrades Grade[]
  gradeGroups     Json    @default("[]")
  orderIndex      Int     @default(0)

  isDefault Boolean @default(false) // true = created by SeedService bootstrap, false = manually added

  traderCategoryShares          TraderCategoryShare[]
  traderCategoryShareConditions TraderCategoryShareCondition[]
  classifications               Classification[]
  traderStocks                  TraderStock[]
  shipmentItems                 ShipmentItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, seasonId])
}

// -----------------------------------------------------------------------------
// 9. Customer categories and prices
// -----------------------------------------------------------------------------
model CustomerCategories {
  id       Int    @id @default(autoincrement())
  seasonId Int
  season   Season @relation(fields: [seasonId], references: [id])

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  name     String
  grade    String
  price    Decimal  @default(0)
  currency Currency

  classifications     Classification[]
  customerAllocations CustomerAllocation[]
  shipmentItems       ShipmentItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seasonId, customerId, name, grade])
}

// -----------------------------------------------------------------------------
// 10. Trader Category Share (%)
// -----------------------------------------------------------------------------
model TraderCategoryShare {
  id Int @id @default(autoincrement())

  seasonId Int
  season   Season @relation(fields: [seasonId], references: [id])

  traderId Int
  trader   Trader @relation(fields: [traderId], references: [id])

  traderCategoryId Int
  traderCategory   TradersCategories @relation(fields: [traderCategoryId], references: [id])

  percent Decimal

  shareConditionId Int?
  shareCondition   TraderCategoryShareCondition? @relation(fields: [shareConditionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([traderId, traderCategoryId, seasonId, shareConditionId])
}

// -----------------------------------------------------------------------------
// 11. Trader Category Share Condition
// -----------------------------------------------------------------------------
model TraderCategoryShareCondition {
  id Int @id @default(autoincrement())

  seasonId Int
  season   Season @relation(fields: [seasonId], references: [id])

  traderCategoryId Int
  traderCategory   TradersCategories @relation(fields: [traderCategoryId], references: [id])

  name String

  startDate            DateTime
  endDate              DateTime?
  endQuantityThreshold Int?
  endConditionMode     ShareConditionEndMode @default(EITHER)
  status               ShareConditionStatus  @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shares      TraderCategoryShare[]
  traderStock TraderStock[]
}

// -----------------------------------------------------------------------------
// 12. Field Operations
// -----------------------------------------------------------------------------
model FieldHarvest {
  id Int @id @default(autoincrement())

  seasonId Int
  season   Season @relation(fields: [seasonId], references: [id])

  dateGregorian DateTime
  dateHebrew    String
  fieldId       Int
  field         Field    @relation(fields: [fieldId], references: [id])

  updatedById Int
  updatedBy   User @relation(fields: [updatedById], references: [id])

  totalHarvested Int     @default(0)
  totalRejected  Int     @default(0)
  rejectionRate  Decimal @default(0)

  totalAfterRejected Int @default(0)

  ownerHarvested     Int     @default(0)
  ownerRejected      Int     @default(0)
  ownerRejectionRate Decimal @default(0)

  ownerAfterRejected Int @default(0)

  classifiedTotal         Int     @default(0)
  isPartialClassification Boolean @default(false)

  uncalculatedRejected Int @default(0)

  remainsInItalyGradeH Boolean @default(true)
  remainsInItalyGradeV Boolean @default(true)

  notes String?

  slug String @unique // URL-friendly ID (date-field-season)

  // Relations
  classifications Classification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isDeleted Boolean @default(false)

  @@unique([seasonId, dateGregorian, fieldId]) // Prevent duplicate reports per season
  @@index([seasonId])
  @@index([seasonId, fieldId])
  @@index([isDeleted])
}

// -----------------------------------------------------------------------------
// 13. Grading & Classification
// -----------------------------------------------------------------------------
model Classification {
  id Int @id @default(autoincrement())

  seasonId Int
  season   Season @relation(fields: [seasonId], references: [id])

  fieldHarvestId Int
  fieldHarvest   FieldHarvest @relation(fields: [fieldHarvestId], references: [id])

  updatedById Int
  updatedBy   User @relation(fields: [updatedById], references: [id])

  assignmentType AssignmentType
  traderId       Int?
  trader         Trader?        @relation(fields: [traderId], references: [id])
  customerId     Int?
  customer       Customer?      @relation(fields: [customerId], references: [id])

  traderCategoryId Int?
  traderCategory   TradersCategories? @relation(fields: [traderCategoryId], references: [id])

  customerCategoryId Int?
  customerCategory   CustomerCategories? @relation(fields: [customerCategoryId], references: [id])

  grade       Grade?
  pitamStatus PitamStatus
  quantity    Int         @default(0)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slug String @unique // URL-friendly slug

  isDeleted Boolean @default(false)

  @@unique([fieldHarvestId, traderId, customerId, traderCategoryId, customerCategoryId, grade, assignmentType, pitamStatus, isDeleted])
  @@index([seasonId])
  @@index([seasonId, fieldHarvestId])
  @@index([seasonId, assignmentType])
  @@index([seasonId, traderId])
  @@index([seasonId, customerId])
  @@index([isDeleted])
}

// -----------------------------------------------------------------------------
// 14. Trader Inventory & Buffer Management
// -----------------------------------------------------------------------------
model TraderStock {
  id Int @id @default(autoincrement())

  seasonId Int
  season   Season @relation(fields: [seasonId], references: [id])

  date DateTime

  traderId Int? // null if Modulo
  trader   Trader? @relation(fields: [traderId], references: [id])

  traderCategoryId Int
  traderCategory   TradersCategories @relation(fields: [traderCategoryId], references: [id])

  grade       Grade
  pitamStatus PitamStatus
  quantity    Int         @default(0)
  isModulo    Boolean     @default(false)

  type MovementType @default(HARVEST_IN)

  isFromPrivateSelection Boolean @default(false)

  MovementReferenceId Int? // classificationId, shipmentItemId or customerAllocationsId

  pitamSplitBatchId String? @db.Uuid

  shareConditionId Int?
  shareCondition   TraderCategoryShareCondition? @relation(fields: [shareConditionId], references: [id])

  shipmentId Int?
  boxId      Int?
  box        Box? @relation(fields: [boxId], references: [id])

  notes String?

  updatedById Int
  updatedBy   User @relation(fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isDeleted Boolean @default(false)

  @@index([seasonId, type])
  @@index([seasonId, traderId, type])
  @@index([traderCategoryId, grade, pitamStatus, type])
  @@index([isDeleted])
  @@index([pitamSplitBatchId])
  @@index([seasonId, shareConditionId])
}

// -----------------------------------------------------------------------------
// 15. Customer Allocations (Sales)
// -----------------------------------------------------------------------------
model CustomerAllocation {
  id Int @id @default(autoincrement())

  seasonId Int
  season   Season @relation(fields: [seasonId], references: [id])

  date       DateTime
  dateHebrew String

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  customerCategoryId Int
  customerCategory   CustomerCategories @relation(fields: [customerCategoryId], references: [id])

  pitamStatus PitamStatus
  quantity    Int

  type MovementType @default(HARVEST_IN)

  takenFrom        SourceType @default(GENERAL)
  traderId         Int?
  traderSourceName Trader?    @relation(fields: [traderId], references: [id])

  MovementReferenceId Int? // classificationId, shipmentItemId or traderStockId

  shipmentId Int?
  boxId      Int?

  notes String?

  updatedById Int
  updatedBy   User @relation(fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isDeleted Boolean @default(false)

  @@index([seasonId, type])
  @@index([seasonId, customerId, type])
  @@index([customerId, traderId, type])
  @@index([customerCategoryId, pitamStatus, type])
  @@index([isDeleted])
}

// -----------------------------------------------------------------------------
// 16. Shipment
// -----------------------------------------------------------------------------
model Shipment {
  id Int @id @default(autoincrement())

  shipmentNumber Int @default(autoincrement())

  seasonId Int
  season   Season @relation(fields: [seasonId], references: [id])

  totalBoxes    Int @default(0)
  totalQuantity Int @default(0)

  status    ShipmentStatus @default(PREPARING)
  shippedAt DateTime?

  notes String?

  // Relations: One Shipment -> Many Boxes -> Many Items
  boxes Box[]
  items ShipmentItem[]

  updatedById Int
  updatedBy   User @relation(fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slug String @unique

  isDeleted Boolean @default(false)

  @@unique([seasonId, shipmentNumber])
  @@index([seasonId])
  @@index([seasonId, status])
  @@index([isDeleted])
}

// -----------------------------------------------------------------------------
// 17. Box - Container
// -----------------------------------------------------------------------------
model Box {
  id         Int      @id @default(autoincrement())
  shipmentId Int
  shipment   Shipment @relation(fields: [shipmentId], references: [id])

  seasonId Int
  season   Season @relation(fields: [seasonId], references: [id])

  boxNumber     Int // e.g., Box #1 in Shipment X
  boxType       BoxType
  totalQuantity Int     @default(0)

  status BoxStatus @default(OPEN)

  notes String?

  // Relations: One Box -> Many Items
  items        ShipmentItem[]
  traderStocks TraderStock[]

  // Ownership
  ownershipType     BoxOwnership @default(GENERAL)
  traderId          Int? // optional, if ownershipType = TRADER
  trader            Trader?      @relation(fields: [traderId], references: [id])
  customerId        Int? // optional, if ownershipType = CUSTOMER
  customer          Customer?    @relation(fields: [customerId], references: [id])
  externalOwnerName String? // required, if ownershipType = EXTERNAL_TRADER

  updatedById Int
  updatedBy   User @relation(fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isDeleted Boolean @default(false)

  @@unique([seasonId, boxNumber])
  @@index([seasonId])
  @@index([shipmentId])
  @@index([traderId])
  @@index([customerId])
  @@index([seasonId, status])
  @@index([traderId, status])
  @@index([customerId, status])
  @@index([isDeleted])
}

// -----------------------------------------------------------------------------
// 18. Items - Products
// -----------------------------------------------------------------------------
model ShipmentItem {
  id         Int      @id @default(autoincrement())
  shipmentId Int
  shipment   Shipment @relation(fields: [shipmentId], references: [id])

  boxId Int
  box   Box @relation(fields: [boxId], references: [id])

  seasonId Int
  season   Season @relation(fields: [seasonId], references: [id])

  // Product Specs (Snapshot of what was packed)
  traderCategoryId Int?
  traderCategory   TradersCategories? @relation(fields: [traderCategoryId], references: [id])

  customerCategoryId Int?
  customerCategory   CustomerCategories? @relation(fields: [customerCategoryId], references: [id])

  grade       Grade?
  pitamStatus PitamStatus
  quantity    Int

  notes       String?
  customLabel String? // free-text category label for CUSTOM ownership items (no FK category)
  customGrade String? // free-text grade for CUSTOM ownership items

  // Ownership
  ownershipType          ItemOwnership @default(GENERAL)
  generalSourceBreakdown Json? // populated for GENERAL items: [{traderId, traderName, quantity}], traderId null = modulo
  traderId               Int? // optional, if ownershipType = TRADER
  trader                 Trader?       @relation(fields: [traderId], references: [id])
  customerId             Int? // optional, if ownershipType = CUSTOMER
  customer               Customer?     @relation(fields: [customerId], references: [id])
  isPrivateSelection     Boolean       @default(false) // true = packed from trader's PRIVATE_SELECTION stock

  updatedById Int
  updatedBy   User @relation(fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isDeleted Boolean @default(false)

  @@unique([seasonId, boxId, traderCategoryId, customerCategoryId, grade, pitamStatus, ownershipType, traderId, customerId, isPrivateSelection, isDeleted])
  @@index([shipmentId])
  @@index([boxId])
  @@index([seasonId])
  @@index([customerId])
  @@index([seasonId, shipmentId])
  @@index([traderId, shipmentId])
  @@index([customerId, shipmentId])
  @@index([isDeleted])
}

// -----------------------------------------------------------------------------
// Enums (Italy module)
// -----------------------------------------------------------------------------
enum Grade {
  א
  ב
  ג
  ד
  ה
  ו
  ללא
}

enum AssignmentType {
  GENERAL
  TRADER
  CUSTOMER
}

enum SourceType {
  GENERAL
  TRADER
}

enum MovementType {
  // --- Inbound Operations ---
  HARVEST_IN // Initial entry from field sorting/grading (Positive)

  // --- Inventory Logic & Ownership Transfers ---
  INTERNAL_TRANSFER // Transfer between Trader <-> Customer
  OWNERSHIP_TRANSFER // Transfer between Trader <-> Trader
  ASSIGNED // Assigned from general pool (Modulo) to trader
  PRIVATE_SELECTION // Trader personally selected specific etrogs for themselves (not from general distribution)

  // --- Physical Outbound Operations ---
  PACKED_SHIPPED // Goods physically left the warehouse via shipment (Negative)
  SELF_PICKUP // Goods physically collected by the owner/customer (Negative)

  // --- Adjustments & Losses ---
  WASTE // Spoilage, damage, or quality rejection (Negative)
  ADJUSTMENT // Manual inventory correction for typos or audits (Positive/Negative)

  // --- Pitam Classification ---
  PITAM_SPLIT // Splits a MIXED pitam balance into WITH_PITAM/WITHOUT_PITAM without altering the original classification (Positive/Negative)

  // --- Regional Retention ---
  REMAINS_IN_ITALY // Grade ה/ו sorted under GENERAL assignment; stays in Italy, not split among traders (Positive)

  // --- Reclassification ---
  RECLASSIFICATION // Changes category/grade/pitamStatus and/or ownership (trader private selection <-> general pool) for a quantity (Positive/Negative)
}

enum BoxType {
  SMALL
  MEDIUM
  LARGE
  CUSTOM
}

enum BoxOwnership {
  TRADER
  CUSTOMER
  SHARED
  GENERAL
  CUSTOM
  EXTERNAL_TRADER
}

enum ItemOwnership {
  TRADER
  CUSTOMER
  GENERAL
  CUSTOM
}

enum ShareConditionEndMode {
  EITHER
  BOTH
}

enum ShareConditionStatus {
  ACTIVE
  DISABLED
  ENDED
}
