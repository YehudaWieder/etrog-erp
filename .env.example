# PostgreSQL connection string used by Prisma and Nest runtime
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/etrog_erp?schema=public"

# Supabase project credentials (Settings → API in Supabase dashboard)
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Comma-separated list of frontend origins allowed to call the API with credentials
ALLOWED_ORIGINS="http://localhost:5173,https://wieders-etrogs.vercel.app"
